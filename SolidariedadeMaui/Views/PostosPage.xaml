<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Solidariedade_Maui.Views.PostosPage"
             Title="Postos de Doação">
    <StackLayout Padding="10">
        <Label Text="Lista de Postos" FontAttributes="Bold" FontSize="24" />
        <CollectionView ItemsSource="{Binding Postos}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <StackLayout Padding="5">
                        <Label Text="{Binding Nome}" FontAttributes="Bold" />
                        <Label Text="{Binding Endereco}" />
                        <Label Text="{Binding Cidade}" />
                        <Label Text="{Binding Estado}" />
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </StackLayout>
</ContentPage>
