<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SolidariedadeMaui.Views.MensagemPage"
             Title="Enviar Mensagem">
    <StackLayout Padding="10" Spacing="10">
        <Label Text="Enviar Mensagem de Solidariedade" FontAttributes="Bold" FontSize="24" HorizontalOptions="Center"/>
        <Entry x:Name="NomeEntry" Placeholder="Nome" />
        <Entry x:Name="EstadoEntry" Placeholder="Estado" />
        <Editor x:Name="MensagemEditor" Placeholder="Digite sua mensagem aqui..." AutoSize="TextChanges" />
        <Button Text="Enviar" Clicked="EnviarMensagem_Clicked" />
        <Label x:Name="ResultadoLabel" TextColor="Green" IsVisible="False" />
    </StackLayout>
</ContentPage>
